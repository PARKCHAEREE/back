# =====================================================================
# [MySQL 실행 프로필 - 로컬 개발용 설정 예시]
#
# [사용 방법]
# 1. 이 파일을 복사해서 같은 폴더에 application-mysql.properties 이름으로 저장
# 2. YOUR_MYSQL_PASSWORD 자리에 본인 MySQL 비밀번호 입력
# 3. 필요 시 username, port, db명도 본인 환경에 맞게 수정
#
# [주의]
# - application-mysql.properties 는 .gitignore 에 등록되어 있습니다.
#   절대 GitHub에 올라가지 않으므로 안심하고 실제 비밀번호를 써도 됩니다.
# - 이 .example 파일은 GitHub에 공유되는 템플릿입니다.
#   실제 비밀번호는 절대 이 파일에 쓰지 마세요.
# =====================================================================

# MySQL 접속 정보
spring.datasource.url=jdbc:mysql://localhost:3306/solarwise?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate 설정
# update: Entity 변경 시 테이블 자동 반영 (기존 데이터 유지)
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=false

# =====================================================================
# [MySQL DB 생성 방법 (최초 1회)]
#
# MySQL 콘솔에서 아래 명령어 실행:
#
#   mysql -u root -p
#   > CREATE DATABASE solarwise CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   > EXIT;
#
# 이후 서버 실행 시 Hibernate가 자동으로 테이블을 생성합니다.
# =====================================================================

